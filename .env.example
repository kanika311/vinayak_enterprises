# App — custom server reads APP_PORT (not Next.js default PORT=3000)
APP_PORT=3002
NODE_ENV=development

# API (same server — relative URL is default)
NEXT_PUBLIC_API_URL=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/scientific_instruments

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (password reset links, CORS)
# Local: http://localhost:3002
# Vercel: set to your live URL, e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:3002
CLIENT_URLS=

# --- Vercel Project Settings → Environment Variables (Production + Preview) ---
# Required for live APIs: MONGODB_URI, JWT_SECRET, JWT_EXPIRES_IN,
# NEXT_PUBLIC_API_URL=/api/v1, CLIENT_URL, CLOUDINARY_*
# Optional: SMTP_*, RATE_LIMIT_*

# Cloudinary (image uploads) — put real values in .env.local only
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
